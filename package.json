{
  "name": "palletvoid",
  "version": "1.0.0",
  "description": "Palletvoid — Complete Premium E-Commerce Platform for Nigeria's foremost pallet crafts store",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3",
    "build": "npm rebuild better-sqlite3 && node database/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node database/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [
    "palletvoid",
    "ecommerce",
    "furniture",
    "nigeria",
    "paystack",
    "pallets"
  ],
  "author": "Palletvoid Global Resources",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.1"
  }
}

# Palletvoid Platform Environment Variables Configuration
# Copy this file to .env and adjust as necessary for deployment.

# Core Server Configuration
NODE_ENV=development
PORT=5000
APP_NAME="Palletvoid"
APP_URL=http://localhost:5000
SESSION_SECRET="palletvoid-dev-session-secret-change-in-production-2026"

# Business Information
BUSINESS_NAME="Palletvoid"
BUSINESS_TAGLINE="We Think Green, We Think Class, And We Think Creative."
BUSINESS_ADDRESS="10, Opeyemi Street, Off Ijaiye Bus Stop, Abeokuta Expressway, Ijaiye, Lagos, Nigeria."
BUSINESS_EMAIL="mail.palletvoid@gmail.com"
BUSINESS_PHONE="+234 802 472 0412"
BUSINESS_WHATSAPP="+2348024720412"
WHATSAPP_URL="https://wa.me/2348024720412"

# Bank Transfer Default Configuration (Needs owner live validation)
BANK_ACCOUNT_NAME="Palletvoid Global Resources"
BANK_ACCOUNT_NUMBER="1025214241"
BANK_NAME="UBA Bank"
BANK_TRANSFER_ENABLED=true

# Paystack Payment Gateway Configuration (Test credentials by default)
PAYSTACK_SECRET_KEY="pstk_test_secret_placeholder_key"
PAYSTACK_PUBLIC_KEY="pstk_test_public_placeholder_key"
PAYSTACK_WEBHOOK_SECRET="pstk_webhook_placeholder_key"
PAYMENT_MODE=test

# Email / SMTP Configuration (Optional; graceful fallback enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mail.palletvoid@gmail.com
SMTP_PASS=""
SMTP_FROM="Palletvoid <mail.palletvoid@gmail.com>"
EMAIL_NOTIFICATIONS_ENABLED=false

# Upload Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
